diff --git a/pages/secondaryMenu/menu.css b/pages/secondaryMenu/menu.css
new file mode 100644
index 0000000000000000000000000000000000000000..3199ca1a7f4cef8a0c2603e19041622b16bab206
--- /dev/null
+++ b/pages/secondaryMenu/menu.css
@@ -0,0 +1,72 @@
+:root {
+  color-scheme: light dark;
+  font-family: system-ui, sans-serif;
+  font-size: 13px;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  overflow: hidden;
+  background: Canvas;
+  color: CanvasText;
+}
+
+#menu {
+  padding: 5px;
+  border: 1px solid color-mix(in srgb, CanvasText 25%, transparent);
+}
+
+.menu-item {
+  display: grid;
+  grid-template-columns: 18px minmax(0, 1fr) auto 12px;
+  gap: 6px;
+  align-items: center;
+  width: 100%;
+  min-height: 28px;
+  padding: 3px 7px;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+}
+
+.menu-item:focus,
+.menu-item:hover {
+  outline: 0;
+  background: Highlight;
+  color: HighlightText;
+}
+
+.menu-item:disabled {
+  opacity: 0.45;
+  background: transparent;
+  color: inherit;
+}
+
+.menu-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.accelerator {
+  opacity: 0.7;
+  white-space: nowrap;
+}
+
+.separator {
+  height: 1px;
+  margin: 5px 7px;
+  background: color-mix(in srgb, CanvasText 20%, transparent);
+}
+
+.arrow {
+  text-align: right;
+}
