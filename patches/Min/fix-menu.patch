+++ b/pages/secondaryMenu/menu.js
@@ -0,0 +1,97 @@
+const { ipcRenderer } = require('electron')
+
+const menu = document.getElementById('menu')
+const menuStack = []
+
+function formatAccelerator (accelerator) {
+  return (accelerator || '')
+    .replace('CmdOrCtrl', 'Ctrl')
+    .replace('Command', '⌘')
+    .replace('Cmd', '⌘')
+    .replace('Ctrl', 'Ctrl')
+    .replace('Alt', 'Alt')
+    .replace('Shift', 'Shift')
+}
+
+function render (items, parentLabel) {
+  menu.replaceChildren()
+
+  if (menuStack.length > 0) {
+    const back = createButton('‹', parentLabel, '', '')
+    back.addEventListener('click', function () {
+      const previous = menuStack.pop()
+      render(previous.items, previous.parentLabel)
+    })
+    menu.appendChild(back)
+    menu.appendChild(createSeparator())
+  }
+
+  items.forEach(function (item) {
+    if (item.type === 'separator') {
+      menu.appendChild(createSeparator())
+      return
+    }
+
+    const marker = item.type === 'checkbox' && item.checked ? '✓' : ''
+    const button = createButton(marker, item.label, formatAccelerator(item.accelerator), item.submenu ? '›' : '')
+    button.disabled = !item.enabled
+    button.addEventListener('click', function () {
+      if (item.submenu) {
+        menuStack.push({ items: items, parentLabel: parentLabel })
+        render(item.submenu, item.label)
+      } else {
+        ipcRenderer.send('secondary-menu-select', item.path)
+      }
+    })
+    menu.appendChild(button)
+  })
+
+  ipcRenderer.send('secondary-menu-resize', menu.scrollHeight)
+  menu.querySelector('.menu-item:not(:disabled)')?.focus()
+}
+
+function createButton (marker, label, accelerator, arrow) {
+  const button = document.createElement('button')
+  button.className = 'menu-item'
+  button.type = 'button'
+  button.setAttribute('role', 'menuitem')
+
+  ;[marker, label, accelerator, arrow].forEach(function (text, index) {
+    const span = document.createElement('span')
+    span.textContent = text
+    span.className = ['', 'menu-label', 'accelerator', 'arrow'][index]
+    button.appendChild(span)
+  })
+  return button
+}
+
+function createSeparator () {
+  const separator = document.createElement('div')
+  separator.className = 'separator'
+  separator.setAttribute('role', 'separator')
+  return separator
+}
+
+document.addEventListener('keydown', function (event) {
+  const buttons = Array.from(menu.querySelectorAll('.menu-item:not(:disabled)'))
+  const currentIndex = buttons.indexOf(document.activeElement)
+
+  if (event.key === 'Escape') {
+    ipcRenderer.send('secondary-menu-close')
+  } else if (event.key === 'ArrowDown') {
+    buttons[(currentIndex + 1) % buttons.length]?.focus()
+  } else if (event.key === 'ArrowUp') {
+    buttons[(currentIndex - 1 + buttons.length) % buttons.length]?.focus()
+  } else if (event.key === 'ArrowLeft' && menuStack.length > 0) {
+    buttons[0]?.click()
+  } else if (event.key === 'ArrowRight' || event.key === 'Enter' || event.key === ' ') {
+    document.activeElement?.click()
+  } else {
+    return
+  }
+  event.preventDefault()
+})
+
+ipcRenderer.once('secondary-menu-data', function (event, items) {
+  render(items, '')
+})
